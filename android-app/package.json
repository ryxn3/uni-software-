{
  "name": "vokabo-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android app for the Vokabo vocabulary trainer (Capacitor wrapper, fully offline)",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "chart.js": "4.4.4",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  }
}
